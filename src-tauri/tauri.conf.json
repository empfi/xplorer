{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xplorer",
  "version": "0.1.0",
  "identifier": "com.buffy.xplorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xplorer",
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#202020",
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "transfer",
        "title": "File Operation",
        "width": 440,
        "height": 155,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#202020",
        "visible": false,
        "center": false,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "url": "index.html?window=transfer"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
